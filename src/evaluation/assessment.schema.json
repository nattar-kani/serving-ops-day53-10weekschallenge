{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClimateTech Sustainability Assessment",
  "description": "Structural contract for a ClimateTech industry, SDG, and evidence assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "industry",
    "sdg_assessment",
    "evidence_assessment"
  ],
  "properties": {
    "industry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isic_code",
        "classification_status",
        "reason"
      ],
      "properties": {
        "isic_code": {
          "type": "string",
          "minLength": 1
        },
        "isic_label": {
          "type": ["string", "null"]
        },
        "classification_status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sdg_assessment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sdg_number",
          "relationship",
          "rationale",
          "supporting_evidence"
        ],
        "properties": {
          "sdg_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 17
          },
          "relationship": {
            "type": "string",
            "enum": [
              "potential_contribution",
              "reported_contribution",
              "not_established"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "supporting_evidence": {
            "type": ["string", "null"]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "source_type",
        "impact_claim",
        "supporting_evidence",
        "limitations"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["E0", "E1", "E2", "E3"]
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "impact_claim": {
          "type": "string",
          "minLength": 1
        },
        "supporting_evidence": {
          "type": ["string", "null"]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}